# 本地 wrangler dev 用的占位值。复制为 .dev.vars 后再改。不要提交 .dev.vars，也不要写入真实密钥。
# 生产密钥用 `pnpm exec wrangler secret put`，不要写进 wrangler.jsonc。

INGEST_URL=https://example.invalid/api/workspace/mail-ingest
INTEGRATION_ID=00000000-0000-0000-0000-000000000000
INTEGRATION_SECRET=replace-me
FORWARD_TO=verified-destination@example.invalid
ALLOWED_RECIPIENTS=support@example.invalid
PRODUCT_NAME=example-product
FALLBACK_WEBHOOK=
FALLBACK_SIGN_SECRET=
